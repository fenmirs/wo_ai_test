{"profile": [{"activate": true, "name": "开发环境", "domain": "192.168.1.100", "lcgl-prj": ":8080/lcgl-prj", "api-prj": ":8080/api-prj"}, {"activate": false, "name": "测试环境", "domain": "10.0.0.50", "lcgl-prj": ":8080/lcgl-prj", "api-prj": ":8080/api-prj"}, {"activate": false, "name": "生产环境", "domain": "api.example.com", "lcgl-prj": "/lcgl-prj", "api-prj": "/api-prj"}], "apis": [{"chain": [], "name": "用户登录", "api_path": "{domain}{api-prj}/auth/login", "method": "POST", "header": {"Content-Type": "application/json"}, "param": {}, "body": {"username": "demo_user", "password": "demo_password"}, "successAssert": "$.code == 200 && $.data.token != null"}, {"chain": ["用户登录"], "name": "获取用户信息", "api_path": "{domain}{api-prj}/user/info", "method": "GET", "header": {"Authorization": "Bearer {{ref:用户登录.data.token}}"}, "param": {}, "body": {}, "successAssert": "$.code == 200"}, {"chain": ["用户登录"], "name": "获取订单列表", "api_path": "{domain}{api-prj}/orders", "method": "GET", "header": {"Authorization": "Bearer {{ref:用户登录.data.token}}"}, "param": {"page": 1, "pageSize": 20}, "body": {}, "successAssert": "$.code == 200 && $.data.list.length >= 0"}, {"chain": ["用户登录"], "name": "创建订单", "api_path": "{domain}{api-prj}/orders", "method": "POST", "header": {"Authorization": "Bearer {{ref:用户登录.data.token}}", "Content-Type": "application/json"}, "param": {}, "body": {"productId": "PROD001", "quantity": 10, "remark": "测试订单"}, "successAssert": "$.code == 200"}, {"chain": ["用户登录"], "name": "上传文件", "api_path": "{domain}{api-prj}/upload", "method": "POST", "header": {"Authorization": "Bearer {{ref:用户登录.data.token}}"}, "param": {}, "body": {"file": "{{file:demo.txt}}"}, "successAssert": "$.code == 200"}, {"chain": [], "name": "公开接口-获取配置", "api_path": "{domain}{api-prj}/public/config", "method": "GET", "header": {}, "param": {}, "body": {}, "successAssert": "$.code == 200"}, {"chain": [], "name": "健康检查", "api_path": "{domain}/health", "method": "GET", "header": {}, "param": {}, "body": {}, "successAssert": "$.status == 'ok'"}]}