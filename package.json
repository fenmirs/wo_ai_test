{
  "name": "api-test-ui",
  "version": "1.0.0",
  "description": "API 测试工具 - UI 版本",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && electron . --dev\"",
    "dev:hot": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && cross-env ELECTRON_DEV=true OPEN_DEVTOOLS=true electron . --dev\"",
    "dev:electron": "nodemon --watch electron --exec \"cross-env ELECTRON_DEV=true electron . --dev\"",
    "dev:all": "concurrently \"npm run react-start\" \"nodemon --watch electron --exec \\\"cross-env ELECTRON_DEV=true electron . --dev\\\"\"",
    "react-start": "react-scripts start",
    "build": "react-scripts build",
    "electron-build": "electron-builder"
  },
  "keywords": [
    "api",
    "test",
    "electron",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "axios": "^1.6.0",
    "clsx": "^2.0.0",
    "lucide-react": "^0.294.0",
    "monaco-editor": "^0.45.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "react-syntax-highlighter": "^15.5.0",
    "tailwindcss": "^3.3.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "electron-packager": "^17.1.2",
    "electron-reload": "^2.0.0-alpha.1",
    "nodemon": "^3.1.14",
    "wait-on": "^7.2.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "extends": null,
    "appId": "com.apitest.ui",
    "productName": "WoAiTest",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": "portable"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
